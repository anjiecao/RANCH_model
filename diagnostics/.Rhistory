kl_d %>%
filter(!is.na(kl1)) %>%
group_by(t) %>%
count() %>%
left_join(
kl_d %>%
filter(kl1 < 0) %>%
group_by(t) %>% count() %>% rename(under_zero_kl_n = n),
by = c("t")
) %>%
mutate(
under_zero_ratio = under_zero_kl_n / n
) %>%
ggplot(aes(x = t, y = under_zero_ratio)) +
geom_point()+
geom_line()+
xlim(0, 20) +
labs(title = "kl1 under 0 proportion")
